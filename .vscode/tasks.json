{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build pinned serialization sample",
            "type": "process",
            "command": "pwsh",
            "windows": {
                "command": "powershell.exe"
            },
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/build-serialization-sample.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
